<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet Pill (0.9.17): REPLACES your res/layout/item_media.xml. Same ids: mname msub mstatus mplay mbtn. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/q_surface_hi"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/q_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="2"
                android:textColor="@color/q_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/msub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/q_text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mstatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/q_accent_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/q_chip"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/q_ic_play"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="Play"
                android:textColor="@color/q_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mbtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/q_btn_accent"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/q_ic_download"
                android:drawableTint="@color/q_on_accent"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="Download"
                android:textColor="@color/q_on_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
