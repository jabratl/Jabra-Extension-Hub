<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet Pill (0.9.14): page on top, floating address pill at the bottom. Ids kept: web chip panel panelList panelClose progress url menu. Added 0.9.17: panelHead panelBar. Removed: back, close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/q_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Media chip (0.9.17): accent pill floating above the address pill. -->
        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/q_btn_accent"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/q_ic_play"
            android:drawableTint="@color/q_on_accent"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:textColor="@color/q_on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Media sheet (0.9.17): rounded bottom sheet. panelHead = handle + title (drag down to close), panelBar = filter / select bar (built in code). -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_gravity="bottom"
            android:background="@drawable/q_sheet_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/panelHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/q_handle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Found on this page"
                        android:textColor="@color/q_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/panelClose"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close"
                        android:scaleType="center"
                        android:src="@drawable/q_ic_close" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/panelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Address suggestions: sit right above the pill (rows are built in code). -->
        <ScrollView
            android:id="@+id/suggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/q_card"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/suggestList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <!-- Fixed height (72dp = 56dp pill + 8dp above and below) so the page never resizes when the pill shrinks. -->
    <FrameLayout
        android:id="@+id/pillWrap"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:focusableInTouchMode="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/pill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/q_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/secure"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:contentDescription="Search"
                android:scaleType="center"
                android:src="@drawable/q_ic_search" />

            <EditText
                android:id="@+id/url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search or type a web address"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/q_text"
                android:textColorHint="@color/q_text_sub"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/clearUrl"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear address"
                android:scaleType="center"
                android:src="@drawable/q_ic_close"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/tabsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tabs">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q_ic_tabs" />

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:text="1"
                    android:textColor="@color/q_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:scaleType="center"
                android:src="@drawable/q_ic_more" />
        </LinearLayout>

        <!-- Loading progress: thin rounded bar on the bottom edge of the pill. -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/q_progress"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
