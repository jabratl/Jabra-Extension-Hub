<?xml version="1.0" encoding="utf-8"?>
<!-- H1 shell: Home and Plugins pages share one screen, the bottom bar switches them.
     Downloads and Browser open their own screens. Ids kept: list, empty, count, empty_title,
     empty_msg, search, fab, filter_sort, app_menu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/q_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== Home ===== -->
        <ScrollView
            android:id="@+id/home_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Jabra Hub"
                        android:textColor="@color/q_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/app_menu"
                        android:layout_width="@dimen/q_touch"
                        android:layout_height="@dimen/q_touch"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings"
                        android:src="@drawable/q_ic_settings" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your own plugins, running natively on this phone."
                    android:textColor="@color/q_text_sub"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/home_pill"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/q_pill_height"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/q_pill"
                    android:clickable="true"
                    android:contentDescription="Search plugins"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="@dimen/q_icon_size"
                        android:layout_height="@dimen/q_icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/q_ic_search" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:text="Search plugins"
                        android:textColor="@color/q_text_sub"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- H2: last used plugin -->
                <LinearLayout
                    android:id="@+id/home_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/q_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">

                        <TextView
                            android:id="@+id/continue_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/q_tile"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textColor="@color/q_accent_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/continue_icon_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/q_tile"
                            android:clipToOutline="true"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continue"
                            android:textColor="@color/q_accent_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/continue_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/q_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- H2: pinned plugins -->
                <LinearLayout
                    android:id="@+id/home_pins_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pinned"
                        android:textColor="@color/q_accent_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_pins_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap the star on a plugin in Plugins to pin it here."
                        android:textColor="@color/q_text_sub"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/home_pins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-8dp"
                        android:layout_marginEnd="-8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/q_text_sub"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/home_import"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/q_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="@dimen/q_icon_size"
                            android:layout_height="@dimen/q_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/q_ic_add"
                            android:tint="@color/q_accent_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Import plugin"
                            android:textColor="@color/q_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="From a .zip file"
                            android:textColor="@color/q_text_sub"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_scan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/q_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="96dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="@dimen/q_icon_size"
                            android:layout_height="@dimen/q_icon_size"
                            android:importantForAccessibility="no"
                            android:src="@drawable/q_ic_copy"
                            android:tint="@color/q_accent_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Scan copied text"
                            android:textColor="@color/q_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Send the clipboard to a plugin"
                            android:textColor="@color/q_text_sub"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ===== Plugins ===== -->
        <ScrollView
            android:id="@+id/plugins_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="88dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/q_touch"
                    android:gravity="center_vertical"
                    android:text="Plugins"
                    android:textColor="@color/q_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/q_pill_height"
                    android:layout_marginTop="12dp"
                    android:autofillHints="none"
                    android:background="@drawable/q_pill"
                    android:drawableStart="@drawable/q_ic_search"
                    android:drawablePadding="12dp"
                    android:hint="Search plugins"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/q_text"
                    android:textColorHint="@color/q_text_sub"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/q_chip"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/q_accent_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/filter_sort"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/q_touch"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/q_text"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/q_ic_tune"
                        android:drawablePadding="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/q_ic_apps"
                        android:tint="@color/q_text_sub" />

                    <TextView
                        android:id="@+id/empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No plugins yet"
                        android:textColor="@color/q_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/empty_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Tap Import plugin and choose a plugin .zip file."
                        android:textColor="@color/q_text_sub"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="Import plugin"
            android:textColor="@color/q_on_accent"
            android:visibility="gone"
            app:backgroundTint="@color/q_accent"
            app:icon="@drawable/q_ic_add"
            app:iconTint="@color/q_on_accent" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/q_surface"
        android:theme="@style/ThemeOverlay.Q.Nav"
        app:itemIconTint="@color/q_nav_item"
        app:itemTextColor="@color/q_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/q_nav_main" />
</LinearLayout>
